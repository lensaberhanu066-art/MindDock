{
  "name": "minddock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.js",
    "dev": "npm run clean && next dev",
    "build": "npm run clean && next build",
    "start": "npm run clean && next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:import-json": "node --env-file=.env scripts/import-json.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@prisma/client": "^6.19.0",
    "next": "14.2.15",
    "postcss": "^8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "prisma": "^6.19.0",
    "typescript": "5.6.3"
  }
}
